# Copy this file to .env and fill it in: cp .env.example .env
# serve.py reads .env and hands the values to the game (as src/cloudConfig.js).
# Leave them empty to play offline, saving only in the browser.
#
# For the live site, set the same two names as repository variables on GitHub:
# Settings -> Secrets and variables -> Actions -> Variables.

# Supabase dashboard -> Project Settings -> API (or the Connect button).
SUPABASE_URL=https://your-project-ref.supabase.co

# The anon or publishable key. It's meant to be public: the row level security
# rules in supabase/schema.sql keep each player's save private.
# NEVER use the service_role / secret key here, or anywhere in the game.
SUPABASE_KEY=your-anon-or-publishable-key

# Testing only: run the time of day this many times faster than real time, and
# cycle the weather (clear, overcast, rain, fog) one per in-game day.
# 720 = a whole day in 2 minutes. Leave unset (or 1) to use the real clock.
# TIME_SPEED=720
